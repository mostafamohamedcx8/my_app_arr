# Copy to application-local.yml and adjust for your machine.
# application-local.yml is git-ignored — never commit real credentials.
spring:
  datasource:
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:myapp}?serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:changeme}
    hikari:
      maximum-pool-size: 5
      minimum-idle: 1
  jpa:
    # Local server is MariaDB (XAMPP): set the dialect explicitly instead of letting Hibernate detect it
    database-platform: org.hibernate.dialect.MariaDBDialect
    show-sql: false
    properties:
      hibernate:
        format_sql: true

logging:
  level:
    root: INFO
    com.myapp.aqdeeha: DEBUG
    org.hibernate.SQL: DEBUG
    org.hibernate.orm.jdbc.bind: TRACE
    org.flywaydb: INFO

server:
  error:
    include-message: always

app:
  cors:
    # Expo web dev server (npx expo start --web) and common local dashboard ports
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:5173}
  security:
    jwt:
      secret: ${JWT_SECRET:<base64 of 32+ random bytes>}
    hash-pepper: ${HASH_PEPPER:<32+ random characters>}
    bootstrap-key: ${BOOTSTRAP_KEY:<random string, needed once to create the super admin>}
  storage:
    id-card-key: ${ID_CARD_ENCRYPTION_KEY:<base64 of exactly 32 random bytes>}
  whatsapp:
    provider: console     # OTP codes are printed in the application log
