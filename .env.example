# Environment variables for dev / prod profiles (local has defaults in application-local.yml)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_HOST=
DB_PORT=3306
DB_NAME=myapp
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=20

# Auth / security (generate fresh random values per environment)
JWT_SECRET=            # base64 of >= 32 random bytes
HASH_PEPPER=           # >= 32 random characters
BOOTSTRAP_KEY=         # random string; only needed for the one-time super-admin bootstrap
ID_CARD_ENCRYPTION_KEY= # base64 of exactly 32 random bytes — NEVER change after ID cards are stored
STORAGE_ROOT=./uploads
WHATSAPP_PROVIDER=console   # dev only. prod must use a real provider (none implemented yet)

# Maps (server-side only)
GOOGLE_MAPS_API_KEY=   # Distance Matrix API; empty = every distance is ESTIMATED (Haversine x 1.3)

# Browser origins allowed to call the API (admin dashboard, Expo web). Comma-separated.
CORS_ALLOWED_ORIGINS=
